
config hiddify 'main'
	option enabled '0'
	option sub_url ''
	option sub_update_hours '12'
	option core_path '/usr/bin/hiddify-core'
	option core_asset 'auto'
	option log_level 'warn'
	option log_persist '1'
	option log_file '/etc/hiddify/log/hiddify.log'
	option log_max_kb '1024'
	option mixed_port '12334'
	option region 'other'
	option block_ads '0'
	option ntp '1'
	option balancer 'round-robin'
	option default_server 'lowest'
	option test_url 'http://cp.cloudflare.com/'
	option url_test_interval '600'
	option pw2_node 'hiddify'

config dns 'dns'
	option remote_dns 'https://1.1.1.1/dns-query'
	option remote_strategy ''
	option direct_dns '1.1.1.1'
	option direct_strategy ''
	option independent_cache '0'
	option ipv6_mode ''

config tls 'tls'
	option fragment '0'
	option fragment_size '10-100'
	option fragment_sleep '50-200'
	option mixed_sni_case '0'
	option padding '0'
	option padding_size '1200-1500'

config mux 'mux'
	option enabled '0'
	option protocol 'h2mux'
	option max_streams '8'
	option padding '1'

config warp 'warp'
	option enabled '0'
	option mode 'proxy_over_warp'
	option clean_ip 'auto'
	option clean_port '0'
	option noise '1-3'
	option noise_size '10-30'
	option noise_delay '10-30'
	option noise_mode 'm4'
