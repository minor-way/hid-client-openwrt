#!/bin/sh /etc/rc.common
# hiddify-core service: SOCKS/HTTP proxy on 127.0.0.1:<mixed_port>, meant to be used as a Passwall2 node.

# shellcheck disable=SC2034
START=91
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

. /usr/share/hiddify/common.sh

SETTINGS=/var/etc/hiddify/settings.json
CRON=/etc/crontabs/root
CRON_SUB="# hiddify-sub"
CRON_LOG="# hiddify-log"
NFT_TABLE=hiddify
# syslog lines from hiddify-core (procd stdout) and from our scripts (logger -t hiddify);
# logread -e takes a POSIX basic regex
LOG_FILTER='hiddify\(-core\[[0-9]*\]\)\{0,1\}:'

# Passwall2 returns early on mark 0xff in its OUTPUT chains; marking hiddify's own sockets
# keeps its traffic to the proxy servers from being looped back into Passwall2.
nft_up() {
	local gid
	gid="$(grep '^hiddify:' /etc/group | cut -d: -f3)"
	[ -n "$gid" ] || return 1
	nft delete table inet "$NFT_TABLE" 2>/dev/null
	nft -f - <<-EOF
		table inet $NFT_TABLE {
			chain output {
				type route hook output priority mangle - 2; policy accept;
				meta skgid $gid meta mark set 0x000000ff counter
			}
		}
	EOF
}

nft_down() {
	nft delete table inet "$NFT_TABLE" 2>/dev/null
}

# cron_set <sub_update_hours> <persist_log 0|1>
cron_set() {
	local hours="$1" persist="$2" spec
	touch "$CRON"
	sed -i "/$CRON_SUB\$/d; /$CRON_LOG\$/d" "$CRON"
	if [ "${hours:-0}" -gt 0 ] 2>/dev/null; then
		if [ "$hours" -ge 24 ]; then
			spec="17 4 * * *"
		else
			spec="17 */$hours * * *"
		fi
		echo "$spec /usr/share/hiddify/sub_update.sh >/dev/null 2>&1 $CRON_SUB" >> "$CRON"
	fi
	[ "$persist" = 1 ] && echo "*/10 * * * * /usr/share/hiddify/log_rotate.sh >/dev/null 2>&1 $CRON_LOG" >> "$CRON"
	/etc/init.d/cron restart >/dev/null 2>&1
}

# Copy hiddify syslog lines to a file on flash so they survive reboots.
log_instance() {
	local file
	file="$(hcfg main log_file /etc/hiddify/log/hiddify.log)"
	mkdir -p "$(dirname "$file")"
	procd_open_instance log
	procd_set_param command /sbin/logread -f -l 1 -e "$LOG_FILTER" -F "$file"
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

start_service() {
	local enabled core url persist
	enabled="$(hcfg main enabled 0)"
	core="$(hcfg main core_path /usr/bin/hiddify-core)"
	url="$(hcfg main sub_url)"
	persist="$(hcfg main log_persist 1)"

	if [ "$enabled" != 1 ]; then
		nft_down
		cron_set 0 0
		return 0
	fi

	cron_set "$(hcfg main sub_update_hours 12)" "$persist"
	[ "$persist" = 1 ] && log_instance

	if [ ! -x "$core" ]; then
		hlog "core binary $core missing, install it from LuCI (Services > Hiddify)"
		return 1
	fi

	mkdir -p "$HIDDIFY_DIR" "$HIDDIFY_RUN"
	chown hiddify:hiddify "$HIDDIFY_DIR"
	[ -f "$HIDDIFY_SUB" ] && chown hiddify:hiddify "$HIDDIFY_SUB"
	chown -R hiddify:hiddify "$HIDDIFY_DIR/data" "$HIDDIFY_DIR/tmp" 2>/dev/null

	# Fetch on first start or when the URL changed; sub_update.sh restarts us once it has data.
	if [ -n "$url" ] && { [ ! -s "$HIDDIFY_SUB" ] || [ "$(cat "$HIDDIFY_DIR/sub.url" 2>/dev/null)" != "$url" ]; }; then
		echo "$url" > "$HIDDIFY_DIR/sub.url"
		rm -f "$HIDDIFY_SUB"
		( /usr/share/hiddify/sub_update.sh >/dev/null 2>&1 & )
		hlog "subscription not cached yet, downloading in background"
		return 0
	fi
	if [ ! -s "$HIDDIFY_SUB" ]; then
		hlog "no subscription configured"
		return 1
	fi

	ucode /usr/share/hiddify/gen_settings.uc "$SETTINGS" || return 1
	chmod 644 "$SETTINGS"
	nft_up || hlog "failed to install nft mark rule (is the hiddify group missing?)"

	procd_open_instance core
	procd_set_param command "$core" run --disable-color -D "$HIDDIFY_DIR" -c "$HIDDIFY_SUB" -d "$SETTINGS"
	# content changes (same command line) must still restart the instance on reload
	procd_set_param file "$SETTINGS" "$HIDDIFY_SUB"
	procd_set_param user hiddify
	procd_set_param group hiddify
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	( /usr/share/hiddify/select_restore.sh >/dev/null 2>&1 & )
}

stop_service() {
	nft_down
}

service_stopped() {
	[ "$(hcfg main enabled 0)" = 1 ] || cron_set 0 0
}

service_triggers() {
	procd_add_reload_trigger hiddify
}
